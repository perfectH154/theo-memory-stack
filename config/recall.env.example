# Local read-only recall service
RECALL_ENABLED=true
RECALL_INJECT_ENABLED=true
RECALL_SHADOW_MODE=false
RECALL_URL=http://127.0.0.1:8788/search
RECALL_MAX_RESULTS=5
RECALL_CANDIDATE_LIMIT=8
RECALL_INJECT_LIMIT=2
RECALL_INJECT_MIN_SCORE=0.35
RECALL_TIMEOUT_MS=800

# Optional model-led classifier and reranker.
# Use a local OpenAI-compatible endpoint for privacy, for example llama.cpp,
# Ollama, or another local server. Leave disabled for retrieval-only testing.
RECALL_CLASSIFIER_ENABLED=false
RECALL_CLASSIFIER_BASE_URL=http://127.0.0.1:8080/v1
RECALL_CLASSIFIER_MODEL=local-model
RECALL_CLASSIFIER_API_KEY=
RECALL_CLASSIFIER_JSON_MODE=true
RECALL_CLASSIFIER_DISABLE_THINKING=true
RECALL_CLASSIFIER_TIMEOUT_MS=800
RECALL_INJECT_CLASSIFIER_TIMEOUT_MS=2500
RECALL_CLASSIFIER_MAX_TOKENS=250
RECALL_RERANK_TIMEOUT_MS=2500
RECALL_RERANK_MAX_TOKENS=180
RECALL_RERANK_MIN_CONFIDENCE=0.65
